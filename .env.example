# Copy to .env and fill in. Never commit .env.

# --- Core ---
# PostgreSQL connection string. With the bundled docker-compose:
# postgresql://brief:brief@localhost:5432/brief
DATABASE_URL=
# Separate database used by `npm test` (it is wiped between test files).
TEST_DATABASE_URL=
# Public base URL used in emails, RSS and canonical links (no trailing slash).
APP_BASE_URL=http://localhost:3000
# Long random string used to hash tokens and IPs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# --- Ingestion ---
# User-Agent sent to feeds. Include a contact URL or email so publishers can reach you.
FETCH_USER_AGENT=
# Optional outbound HTTP(S) proxy. When set, DNS pinning is done by the proxy,
# so only pre-connect IP validation applies (see README "SSRF").
FETCH_PROXY_URL=

# --- Email ---
# console (default, stores mail in the admin "Dev mailbox"), smtp (e.g. Mailpit), or resend
EMAIL_PROVIDER=console
EMAIL_FROM=
EMAIL_REPLY_TO=
# smtp provider (Mailpit: host localhost, port 1025)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# resend provider
RESEND_API_KEY=

# --- AI (optional; used by the news agent and the story editor) ---
# Set AI_PROVIDER=anthropic AND ANTHROPIC_API_KEY to turn AI on. Without a key the
# news agent uses the publisher's own wording.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-5-5).
AI_MODEL=

# --- News agent ---
# Emergency stop: set to 1 to disable the automatic news agent entirely.
AGENT_DISABLED=

# --- Scheduled work without a worker process (optional) ---
# Enables POST /api/cron with header "Authorization: Bearer <CRON_SECRET>". 32+ characters.
CRON_SECRET=

# --- Admin bootstrap (optional, read once by `npm run admin:create`) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
